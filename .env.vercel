# Vercel Environment Configuration for BRUDF Website

# ===========================================
# DATABASE CONFIGURATION (VERCEL PRODUCTION)
# ===========================================

# Use Supabase for Vercel deployment (recommended)
DB_PROVIDER=supabase

# ===========================================
# SUPABASE CONFIGURATION FOR VERCEL
# ===========================================
# Add these to your Vercel dashboard environment variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_KEY=your_production_service_key
SUPABASE_HOST=db.your-project.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_production_password

# Alternative: Vercel Postgres (if you prefer Vercel's database)
# DB_PROVIDER=postgresql
# POSTGRES_HOST=$POSTGRES_HOST
# POSTGRES_PORT=$POSTGRES_PORT  
# POSTGRES_DB=$POSTGRES_DATABASE
# POSTGRES_USER=$POSTGRES_USER
# POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# ===========================================
# SECURITY CONFIGURATION (VERCEL)
# ===========================================
DB_ENCRYPTION_KEY=your_secure_32_character_production_key
JWT_SECRET=your_secure_jwt_secret_for_production

# ===========================================
# BACKUP CONFIGURATION (VERCEL)
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# ===========================================
# RATE LIMITING (VERCEL)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ===========================================
# APPLICATION SETTINGS (VERCEL)
# ===========================================
NODE_ENV=production
ADMIN_PASSWORD=brudf2024admin
CORS_ORIGIN=https://your-domain.vercel.app