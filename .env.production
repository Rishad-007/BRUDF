# Production Environment Configuration for BRUDF Website

# ===========================================
# DATABASE CONFIGURATION (PRODUCTION)
# ===========================================

# Use Supabase for production (recommended)
DB_PROVIDER=supabase

# ===========================================
# SUPABASE PRODUCTION CONFIGURATION
# ===========================================
# Replace with your actual Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_KEY=your_production_service_key
SUPABASE_HOST=db.your-project.supabase.co
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_production_password

# Alternative: Regular PostgreSQL
# DB_PROVIDER=postgresql
# POSTGRES_HOST=your-postgres-host
# POSTGRES_PORT=5432
# POSTGRES_DB=brudf_production
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_production_password

# ===========================================
# SECURITY CONFIGURATION (PRODUCTION)
# ===========================================
DB_ENCRYPTION_KEY=your_secure_32_character_production_key
JWT_SECRET=your_secure_jwt_secret_for_production

# ===========================================
# BACKUP CONFIGURATION (PRODUCTION)
# ===========================================
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# ===========================================
# RATE LIMITING (PRODUCTION)
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ===========================================
# APPLICATION SETTINGS (PRODUCTION)
# ===========================================
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://your-domain.com