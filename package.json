{
  "name": "brudf-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "dev:server": "node server/index.js",
    "render-build": "npm install && npm run build",
    "backup:create": "node server/database.js --backup",
    "backup:csv": "node server/csvReader.js --export",
    "data:recover": "node server/dataRecovery.js",
    "data:backup": "node -e \"import('./server/database.js').then(db => db.createDatabaseBackup().then(() => db.createCSVBackup()))\"",
    "data:check": "node -e \"import('./server/csvReader.js').then(csv => csv.persistenceManager.loadFromMultipleLocations().then(data => console.log('Available data sources:', data.length)))\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0",
    "vite": "^4.4.5"
  }
}
